# Copie para .env e ajuste (o ./bootstrap.sh cria o .env a partir deste arquivo).

# Disco base, só para criar a VM do zero (./vm/setup_vm.sh); nunca é alterado, é clonado para VM_WORKDIR.
# Partindo do poi-vm.ova (./vm/setup_vm.sh --existing) pode ficar vazio.
BASE_VDI=
# pasta de trabalho no host: clone do disco, log do VBoxHeadless, known_hosts e sockets SSH
VM_WORKDIR=$HOME/poi/vms/work
VM_NAME=poi-vm

# Credenciais da imagem (roteiro); a senha só é usada no setup_vm.sh
VM_USER=osboxes
VM_PASS=osboxes.org
SSH_KEY=$HOME/.ssh/poi_vm_ed25519

# Portas no host (NAT → mesma porta no convidado, exceto SSH e nginx)
SSH_PORT=2222
NGINX_PORT=8080
CPU_PORT=8001
MEM_PORT=8002
IO_PORT=8003

# Afinidade de CPU no formato do taskset (ex. VM_CPUSET=4-11, K6_CPUSET=0-3). Vazio = sem afinidade.
# Útil para separar a VM do gerador de carga (k6) em CPUs híbridas; confira a topologia com: lscpu -e
VM_CPUSET=
K6_CPUSET=

# conda no host
CONDA_ROOT=$HOME/miniforge3

# ---- Atividade 4: Docker (DOCKER.md) ----
# Docker Hub: imagens <DOCKERHUB_USER>/poi-cpu, poi-mem, poi-io. Nunca coloque senha ou token aqui (use docker login).
DOCKERHUB_USER=lucassousapereira
POI_TAG=1.0
# PLATFORM=linux/amd64           # build_push.sh; várias arquiteturas (ex. linux/amd64,linux/arm64) usam buildx + --push
# Workers do uvicorn por serviço; vazio = CPUs disponíveis ao container
CPU_WORKERS=
MEM_WORKERS=
IO_WORKERS=

# VM da Cloud do LSD (deploy.sh)
LSD_HOST=
LSD_USER=
LSD_SSH_KEY=
LSD_SSH_PORT=22
LSD_DIR=poi-docker
LSD_DOCKER=docker                # "sudo docker" se o usuário não estiver no grupo docker
