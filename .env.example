# Copie para .env e ajuste.

# Disco base (nunca é alterado; é clonado para VM_WORKDIR)
BASE_VDI=$HOME/poi/vms/ubuntu_serve_2204_poi.vdi
VM_WORKDIR=$HOME/poi/vms/work
VM_NAME=poi-vm

# Credenciais da imagem (roteiro); a senha só é usada no setup_vm.sh
VM_USER=osboxes
VM_PASS=osboxes.org
SSH_KEY=$HOME/.ssh/poi_vm_ed25519

# Portas no host (NAT → mesma porta no convidado, exceto SSH e nginx)
SSH_PORT=2222
NGINX_PORT=8080
CPU_PORT=8001
MEM_PORT=8002
IO_PORT=8003

# Afinidade (Core 7 150U: CPUs 0-3 = 2 P-cores com HT, 4-11 = 8 E-cores)
VM_CPUSET=4-11
K6_CPUSET=0-3

# conda no host
CONDA_ROOT=$HOME/miniforge3
